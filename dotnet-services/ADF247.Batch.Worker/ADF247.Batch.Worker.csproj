<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-ADF247.Batch.Worker-3caea9c9-5dd9-4f1e-9871-987a39e67189</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <ProjectReference Include="..\ADF247.Api\ADF247.Api.csproj" />
  </ItemGroup>

  <Target Name="ExcludeApiSettingsFromBatchPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Identity)').Contains('\ADF247.Api\appsettings'))" />
    </ItemGroup>
  </Target>

</Project>
