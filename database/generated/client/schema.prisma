datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

model User {
  id         Int      @id @default(autoincrement())
  nCarnet    String   @unique
  nIndicatiu String?
  name       String
  lastName   String?
  password   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roles                      Role[]
  convocatories              Convocatoria[]              @relation("ConvocatoriaResponsable")
  respostas                  Respuesta[]
  availabilityWindows        AvailabilityWindow[]
  notificationLogs           NotificationLog[]           @relation("NotificationLogSender")
  notificationAutomationRuns NotificationAutomationRun[] @relation("NotificationAutomationRunActor")
  hoursSummary               UserHoursSummary?
}

model Role {
  id            Int     @id @default(autoincrement())
  nCarnet       String
  user          User    @relation(fields: [nCarnet], references: [nCarnet])
  isCapOperatiu Boolean @default(false)
  isCapColla    Boolean @default(false)
  isAdmin       Boolean @default(false)
  isGroc        Boolean @default(false)
}

model ConvoType {
  id              Int     @id @default(autoincrement())
  name            String  @unique
  minGrocSortida  Int     @default(0)
  minVerdSortida  Int     @default(0)
  defaultLocation String?

  convocatories Convocatoria[]
}

model Convocatoria {
  id            Int       @id @default(autoincrement())
  date          DateTime
  title         String
  ubiSortida    String
  responsableId Int?
  user          User?     @relation("ConvocatoriaResponsable", fields: [responsableId], references: [id])
  convoTypeId   Int
  convoType     ConvoType @relation(fields: [convoTypeId], references: [id])

  startTime             DateTime
  finalTime             DateTime?
  actualStartTime       DateTime?
  actualEndTime         DateTime?
  isActive              Boolean   @default(true)
  autoAssignResponsable Boolean   @default(false)
  sortida               Boolean   @default(false)

  respostas          Respuesta[]
  formularisCampanya FormulariCampanya[]
}

model Respuesta {
  id                  Int          @id @default(autoincrement())
  convoId             Int
  convocatoria        Convocatoria @relation(fields: [convoId], references: [id])
  userNCarnet         String
  user                User         @relation(fields: [userNCarnet], references: [nCarnet])
  isCustom            Boolean      @default(false)
  customText          String?
  fullHorari          Boolean      @default(false)
  response            Boolean
  attendanceConfirmed Boolean      @default(true)
  attendanceJustified Boolean      @default(false)
  source              String       @default("manual")
  autoAssignReason    String?

  @@index([source])
}

model NotificationLog {
  id             Int      @id @default(autoincrement())
  senderUserId   Int?
  senderUser     User?    @relation("NotificationLogSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  title          String
  body           String
  dataJson       String?
  requestedCount Int      @default(0)
  successCount   Int      @default(0)
  failureCount   Int      @default(0)
  targetScope    String   @default("all-active-devices")
  status         String   @default("queued")
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model AvailabilityWindow {
  id               Int      @id @default(autoincrement())
  userNCarnet      String
  user             User     @relation(fields: [userNCarnet], references: [nCarnet])
  fromDateTime     DateTime
  toDateTime       DateTime
  availabilityType String
  source           String   @default("manual")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userNCarnet])
  @@index([fromDateTime, toDateTime])
}

model NotificationAutomationRun {
  id            Int       @id @default(autoincrement())
  trigger       String
  source        String
  status        String    @default("running")
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  actorUserId   Int?
  actorUser     User?     @relation("NotificationAutomationRunActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  errorMessage  String?
  correlationId String
  createdAt     DateTime  @default(now())

  tasks NotificationAutomationTaskRun[]

  @@index([createdAt])
  @@index([trigger, status])
  @@index([correlationId])
}

model NotificationAutomationTaskRun {
  id           Int                       @id @default(autoincrement())
  runId        Int
  run          NotificationAutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskKey      String
  status       String                    @default("running")
  startedAt    DateTime                  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  errorMessage String?
  detailsJson  String?
  createdAt    DateTime                  @default(now())

  @@index([runId, taskKey])
  @@index([createdAt])
}

model UserHoursSummary {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignHours          Float    @default(0)
  offCampaignHours       Float    @default(0)
  unansweredCount        Int      @default(0)
  noShowCount            Int      @default(0)
  unansweredPenaltyHours Float    @default(0)
  noShowPenaltyHours     Float    @default(0)
  totalHours             Float    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model FormulariCampanya {
  id                 Int          @id @default(autoincrement())
  convocatoriaId     Int
  convocatoria       Convocatoria @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)
  dia                DateTime
  responsableId      Int?
  responsableNCarnet String?
  voluntarisJson     String
  vehiclesJson       String
  serviceMoment      String
  createdByNCarnet   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([convocatoriaId, serviceMoment])
  @@index([dia])
}
