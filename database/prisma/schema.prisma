datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

model User {
  id         Int      @id @default(autoincrement())
  nCarnet    String   @unique @db.NVarChar(50)
  nIndicatiu String?  @db.NVarChar(Max)
  name       String   @db.NVarChar(Max)
  lastName   String?  @db.NVarChar(Max)
  password   String   @db.NVarChar(Max)
  isActive   Boolean  @default(true)
  phone      String?  @db.NVarChar(Max)
  createdAt  DateTime @default(now()) @db.DateTime2
  updatedAt  DateTime @updatedAt @db.DateTime2

  roles            Role[]
  convocatories    Convocatoria[] @relation("ConvocatoriaResponsable")
  respostas        Respuesta[]
  availabilityWindows AvailabilityWindow[]
  notificationLogs NotificationLog[] @relation("NotificationLogSender")
  notificationAutomationRuns NotificationAutomationRun[] @relation("NotificationAutomationRunActor")
  hoursSummary UserHoursSummary?
}

model Role {
  id            Int     @id @default(autoincrement())
  nCarnet       String  @db.NVarChar(50)
  user          User    @relation(fields: [nCarnet], references: [nCarnet])
  isCapOperatiu Boolean @default(false)
  isCapColla    Boolean @default(false)
  isAdmin       Boolean @default(false)
  isGroc        Boolean @default(false)
}

model ConvoType {
  id              Int     @id @default(autoincrement())
  name            String  @unique @db.NVarChar(100)
  minGrocSortida  Int     @default(0)
  minVerdSortida  Int     @default(0)
  defaultLocation String? @db.NVarChar(Max)

  convocatories Convocatoria[]
}

model Convocatoria {
  id            Int       @id @default(autoincrement())
  date          DateTime  @db.DateTime2
  title         String    @db.NVarChar(Max)
  ubiSortida    String    @db.NVarChar(Max)
  responsableId Int?
  user          User?     @relation("ConvocatoriaResponsable", fields: [responsableId], references: [id])
  convoTypeId   Int
  convoType     ConvoType @relation(fields: [convoTypeId], references: [id])

  startTime     DateTime  @db.DateTime2
  finalTime     DateTime? @db.DateTime2
  actualStartTime DateTime? @db.DateTime2
  actualEndTime DateTime? @db.DateTime2
  isActive      Boolean   @default(true)
  autoAssignResponsable Boolean @default(false)
  sortida       Boolean   @default(false)

  respostas Respuesta[]
  formularisCampanya FormulariCampanya[]
}

model Respuesta {
  id           Int          @id @default(autoincrement())
  convoId      Int
  convocatoria Convocatoria @relation(fields: [convoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userNCarnet  String       @db.NVarChar(50)
  user         User         @relation(fields: [userNCarnet], references: [nCarnet], onDelete: NoAction, onUpdate: NoAction)
  isCustom     Boolean      @default(false)
  customText   String?      @db.NVarChar(Max)
  fullHorari   Boolean      @default(false)
  response     Boolean
  attendanceConfirmed Boolean @default(true)
  attendanceJustified Boolean @default(false)
  source       String       @default("manual") @db.NVarChar(50)
  autoAssignReason String?  @db.NVarChar(Max)

  @@index([source])
}

model NotificationLog {
  id             Int      @id @default(autoincrement())
  senderUserId   Int?
  senderUser     User?    @relation("NotificationLogSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  title          String   @db.NVarChar(Max)
  body           String   @db.NVarChar(Max)
  dataJson       String?  @db.NVarChar(Max)
  requestedCount Int      @default(0)
  successCount   Int      @default(0)
  failureCount   Int      @default(0)
  targetScope    String   @default("all-active-devices") @db.NVarChar(Max)
  status         String   @default("queued") @db.NVarChar(Max)
  errorMessage   String?  @db.NVarChar(Max)
  createdAt      DateTime @default(now()) @db.DateTime2

  @@index([createdAt])
}

model AvailabilityWindow {
  id               Int      @id @default(autoincrement())
  userNCarnet      String   @db.NVarChar(50)
  user             User     @relation(fields: [userNCarnet], references: [nCarnet])
  fromDateTime     DateTime @db.DateTime2
  toDateTime       DateTime @db.DateTime2
  availabilityType String   @db.NVarChar(Max)
  source           String   @default("manual") @db.NVarChar(Max)
  notes            String?  @db.NVarChar(Max)
  createdAt        DateTime @default(now()) @db.DateTime2
  updatedAt        DateTime @updatedAt @db.DateTime2

  @@index([userNCarnet])
  @@index([fromDateTime, toDateTime])
}

model NotificationAutomationRun {
  id           Int      @id @default(autoincrement())
  trigger      String   @db.NVarChar(100)
  source       String   @db.NVarChar(Max)
  status       String   @default("running") @db.NVarChar(50)
  startedAt    DateTime @default(now()) @db.DateTime2
  finishedAt   DateTime? @db.DateTime2
  durationMs   Int?
  actorUserId  Int?
  actorUser    User?    @relation("NotificationAutomationRunActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  errorMessage String?  @db.NVarChar(Max)
  correlationId String  @db.NVarChar(100)
  createdAt    DateTime @default(now()) @db.DateTime2

  tasks NotificationAutomationTaskRun[]

  @@index([createdAt])
  @@index([trigger, status])
  @@index([correlationId])
}

model NotificationAutomationTaskRun {
  id           Int      @id @default(autoincrement())
  runId        Int
  run          NotificationAutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskKey      String   @db.NVarChar(100)
  status       String   @default("running") @db.NVarChar(50)
  startedAt    DateTime @default(now()) @db.DateTime2
  finishedAt   DateTime? @db.DateTime2
  durationMs   Int?
  errorMessage String?  @db.NVarChar(Max)
  detailsJson  String?  @db.NVarChar(Max)
  createdAt    DateTime @default(now()) @db.DateTime2

  @@index([runId, taskKey])
  @@index([createdAt])
}

model UserHoursSummary {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignHours          Float    @default(0)
  offCampaignHours       Float    @default(0)
  unansweredCount        Int      @default(0)
  noShowCount            Int      @default(0)
  unansweredPenaltyHours Float    @default(0)
  noShowPenaltyHours     Float    @default(0)
  totalHours             Float    @default(0)
  createdAt              DateTime @default(now()) @db.DateTime2
  updatedAt              DateTime @updatedAt @db.DateTime2
}

model FormulariCampanya {
  id             Int          @id @default(autoincrement())
  convocatoriaId Int
  convocatoria   Convocatoria @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)
  dia            DateTime     @db.DateTime2
  responsableId  Int?
  responsableNCarnet String?  @db.NVarChar(Max)
  voluntarisJson String       @db.NVarChar(Max)
  vehiclesJson   String       @db.NVarChar(Max)
  serviceMoment  String         @db.NVarChar(50)
  createdByNCarnet String?    @db.NVarChar(Max)
  createdAt      DateTime     @default(now()) @db.DateTime2
  updatedAt      DateTime     @updatedAt @db.DateTime2

  @@index([convocatoriaId, serviceMoment])
  @@index([dia])
}